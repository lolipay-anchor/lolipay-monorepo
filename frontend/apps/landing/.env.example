STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SEP10_SIGNING_PUBLIC=
WEB_AUTH_ENDPOINT=https://api.lolipay.app/auth
KYC_SERVER=https://api.lolipay.app
USDC_ASSET_CODE=USDC
USDC_ASSET_ISSUER=

# Only read when STELLAR_NETWORK_PASSPHRASE is the public network. What the asset is and
# whether it can be redeemed are claims somebody has to decide; they are never derived.
# CURRENCY_STATUS must be one of: live, dead, test, private
CURRENCY_STATUS=
CURRENCY_IS_ASSET_ANCHORED=
CURRENCY_DESC=
# Required only when CURRENCY_IS_ASSET_ANCHORED=true — what the token is redeemable for.
CURRENCY_ANCHOR_ASSET_TYPE=
CURRENCY_ANCHOR_ASSET=
