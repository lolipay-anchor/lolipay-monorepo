{
  "name": "lolipay-coordinator",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "e2e:up": "docker compose -f docker-compose.e2e.yml -p lolipay-e2e up -d && sleep 8 && DATABASE_URL=postgresql://lolipay:lolipay@localhost:5432/lolipay?schema=public prisma migrate deploy",
    "e2e:down": "docker compose -f docker-compose.e2e.yml -p lolipay-e2e down -v",
    "test:all": "npm test && npm run e2e:up && npm run test:e2e; npm run e2e:down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "anchor:test:sep1": "stellar-anchor-tests --home-domain lolipay.app --seps 1",
    "anchor:test:sep10": "stellar-anchor-tests --home-domain lolipay.app --seps 10",
    "anchor:consistency": "npx ts-node -T src/scripts/anchor-consistency.ts lolipay.app"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@stellar/stellar-sdk": "^17.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.2.0",
    "minio": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@stellar/anchor-tests": "0.6.22",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.2.4",
    "jest": "^29.7.0",
    "prisma": "^7.9.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(@exodus/[^/]+|@borewit/text-codec|@isaacs/cliui|@noble/ed25519|@noble/hashes|@stellar/stellar-sdk|@tokenizer/inflate|axios|baseline-browser-mapping|cliui|es-module-lexer|eventsource|eventsource-parser|file-type|foreground-child|formidable|get-package-type|glob|is-retry-allowed|jackspeak|libphonenumber-js|minipass|node-releases|package-json-from-dist|path-scurry|proxy-from-env|smol-toml|strtok3|terser|token-types|uint8array-extras|y18n|yargs|yargs-parser))"
    ],
    "setupFiles": [
      "<rootDir>/jest-setup.ts"
    ]
  },
  "overrides": {
    "socket.io-parser": "^4.2.7",
    "fast-xml-parser": "^5.11.0",
    "axios": "^1.19.0",
    "deepmerge-ts": "^8.0.2"
  }
}
