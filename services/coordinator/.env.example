NODE_ENV=production
PORT=3000

POSTGRES_USER=lolipay
POSTGRES_PASSWORD=            # set a strong password
POSTGRES_DB=lolipay
DATABASE_URL=postgresql://lolipay:CHANGE_ME@postgres:5432/lolipay?schema=public

JWT_SECRET=                  # long random string (e.g. `openssl rand -hex 32`)
JWT_TTL_SECONDS=900
JWT_ISSUER=https://lolipay.app
JWT_AUDIENCE=lolipay-app
AUTH_CHALLENGE_TTL_SECONDS=120
ADMIN_ADDRESSES=             # comma-separated G... allowlist (your admin wallet)

CORS_ORIGINS=https://app.lolipay.app,https://admin.lolipay.app,https://lp.lolipay.app

STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_READ_KEY=            # funded testnet G... PUBLIC key (simulate source; NOT a secret/seed)
STAKING_CONTRACT_ID=         # testnet staking contract C... (deploy/init for testnet USDC)
ESCROW_CONTRACT_ID=          # testnet escrow contract C... (deploy/init for testnet USDC)
ESCROW_CONTRACT_IDS_EXTRA=   # optional, comma-separated: retired escrow contract id(s) to keep indexing after a cutover (orders created before the cutover still finish on-chain there)
REFUND_SIGNER_SECRET=        # optional: S... secret of a FUNDED fee-payer account used ONLY to submit permissionless refund() txs; the key cannot move escrow funds anywhere but back to the original provider
ATTESTOR_SECRET=            # optional: S... secret of the account the escrow names as fiat_attestor; it can only mark a FUNDED top-up as fiat-paid, moves no money, and is refused if it is not the address get_config() returns

PRICE_STALE_SECONDS=120
PRICE_DEVIATION_MAX_BPS=100   # 1%, and INV-30.1 requires it to stay strictly below Config.spreadBps (schema default 150)
PLATFORM_WALLET=             # G... wallet that collects platform fees

HORIZON_URL=https://horizon-testnet.stellar.org
# Both halves are required and the service refuses to start without them.
# They must match the asset the deployed escrow settles in — read it from the
# contract itself: `stellar contract invoke --id <escrow> -- get_config` gives
# usdc_token, and `-- name` on that token gives CODE:ISSUER.
USDC_ASSET_CODE=USDC
USDC_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

ALERT_WEBHOOK_URL=            # unset means every alert is built and then discarded
HEARTBEAT_STALE_SECONDS=120   # a provider older than this is not matched

MINIO_ROOT_USER=              # MinIO credentials, founder-managed
MINIO_ROOT_PASSWORD=          # MinIO credentials, founder-managed

SEP10_SIGNING_KEY=
ANCHOR_HOME_DOMAIN=lolipay.app
SEP10_WEB_AUTH_DOMAIN=api.lolipay.app


DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=

DIDIT_WORKFLOW_ID=
DIDIT_ENVIRONMENT=live
DIDIT_DAILY_SESSION_BUDGET=

# The absolute https base this anchor publishes in SEP-24 transaction URLs.
# Unset refuses to start: a relative more_info_url fails the acceptance suite schema.
ANCHOR_BASE_URL=
