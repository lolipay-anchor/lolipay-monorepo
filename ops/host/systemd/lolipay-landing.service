[Unit]
Description=lolipay landing page (Next.js)
After=network.target

[Service]
Type=simple
User=lolipay
WorkingDirectory=/home/lolipay/lolipay-monorepo/frontend/apps/landing
Environment=PATH=/home/lolipay/.local/node-v22.23.1-linux-x64/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment="STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015"
Environment=WEB_AUTH_ENDPOINT=https://api.lolipay.app/auth
Environment=TRANSFER_SERVER_SEP0024=https://api.lolipay.app/sep24
ExecStart=/home/lolipay/lolipay-monorepo/frontend/apps/landing/node_modules/.bin/next start -p 3004
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
